{
  "manifest_version": 3,
  "name": "Branilist Sync",
  "version": "0.8.1",
  "description": "Acompanhamento automático oficial do Branilist para anime e mangá.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://branilist.com/*",
    "https://www.crunchyroll.com/*",
    "https://crunchyroll.com/*",
    "https://www.netflix.com/*",
    "https://netflix.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "Branilist Sync",
    "default_icon": {
      "16": "icons/branilist-48.png",
      "32": "icons/branilist-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*",
        "https://www.netflix.com/*",
        "https://netflix.com/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*"
      ],
      "js": [
        "assets/network-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/branilist-48.png",
    "32": "icons/branilist-48.png",
    "48": "icons/branilist-48.png",
    "128": "icons/branilist-128.png"
  }
}
