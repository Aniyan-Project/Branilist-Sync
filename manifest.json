{
  "manifest_version": 3,
  "name": "Branilist Sync",
  "version": "0.3.0",
  "description": "Acompanhamento automático oficial do Branilist para anime e mangá.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://branilist.com/*",
    "https://www.crunchyroll.com/*",
    "https://crunchyroll.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "Branilist Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}